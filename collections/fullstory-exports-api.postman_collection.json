          "request": {
            "name": "Create a segment export",
            "description": {
              "content": "Schedules an asynchronous export based on the provided segment. The progress and results of the export can be fetched from the operations API. Two export types are available: individuals (information about users matching the segment) and events (events performed by matching users).",
              "type": "text/plain"
            },
