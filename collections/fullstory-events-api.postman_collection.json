      "id": "dc91f5ee-e931-415f-a46f-548d2c931588",
      "name": "Events",
      "description": {
        "content": "Send custom server-side events to FullStory. Events can be associated with sessions and users, and include custom properties for behavioral analysis.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b15cbe7a-6c14-4a81-ad3b-dfc3d9b3d9f2",
          "name": "Create a single event",
          "request": {
            "name": "Create a single event",
            "description": {
              "content": "Creates one custom event with the specified details. Events can be associated with a session and user. If use_most_recent is true, the most recent session within 30 minutes will be used. Custom properties can be attached and types are inferred automatically in v2.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
