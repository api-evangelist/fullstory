                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"timestamp\": \"<dateTime>\",\n  \"session\": {\n    \"id\": \"<string>\",\n    \"use_most_recent\": \"<boolean>\"\n  },\n  \"user\": {\n    \"id\": \"<string>\",\n    \"uid\": \"<string>\"\n  },\n  \"properties\": {\n    \"key_0\": 5243,\n    \"key_1\": false\n  },\n  \"schema\": {\n    \"key_0\": 7108,\n    \"key_1\": 6930,\n    \"key_2\": true\n  }\n}",
