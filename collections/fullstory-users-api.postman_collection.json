    {
      "id": "a975c2c5-334b-4a54-a739-3c0dcde14731",
      "name": "Users",
      "description": {
        "content": "Create, retrieve, update, and delete users in FullStory. Users can be anonymous or identified with a uid. Custom properties can be attached to enrich user profiles.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "712709a1-e39d-4b85-9dcd-53b7ece0f183",
          "name": "Create or update a user",
          "request": {
            "name": "Create or update a user",
            "description": {
              "content": "Creates a new user or updates an existing user if a matching uid is found. Anonymous users can be created by omitting the uid field. The API returns the FullStory-assigned id along with the user data. Type suffixes are not required for custom properties in v2 as types are inferred automatically.",
              "type": "text/plain"
            },
