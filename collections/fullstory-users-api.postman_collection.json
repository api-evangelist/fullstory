          "name": "Delete a user",
          "request": {
            "name": "Delete a user",
            "description": {
              "content": "Permanently deletes all user data related to the specified user, including sessions, events, custom user properties, raw page files, and corresponding session data. It is recommended to use the Get User endpoint first to verify the correct user before deletion.",
              "type": "text/plain"
            },
            "url": {
