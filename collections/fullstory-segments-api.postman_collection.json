          "name": "List segments",
          "request": {
            "name": "List segments",
            "description": {
              "content": "Returns a paginated list of segments for the organization. You can optionally limit the number of segments returned, with a default of 20 and a maximum of 100 per page. Use the pagination token to retrieve additional pages of results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "segments",
                "v1"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Maximum number of segments to return per page. Default is 20, maximum is 100."
                },
                {
                  "disabled": false,
                  "key": "pagination_token",
                  "value": "<string>",
                  "description": "Token for retrieving the next page of results. Do not change other list parameters between consecutive paginated requests."
